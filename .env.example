# ─────────────────────────────────────────────────────────
#  .env.example  —  safe to commit to your public repo
#
#  How to use:
#  1. Copy this file:   cp .env.example .env.local
#  2. Fill in the real values in .env.local
#  3. NEVER commit .env.local  (already in .gitignore)
#  4. For production: add these same keys in Vercel →
#     Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────

# Resend API key — get yours at https://resend.com/api-keys
# Free tier allows 100 emails/day, 3000/month — perfect for a portfolio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
